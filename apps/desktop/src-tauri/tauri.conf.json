{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch",
  "version": "0.1.0",
  "identifier": "dev.perch.app",
  "build": {
    "beforeDevCommand": "pnpm sidecar:build && pnpm dev",
    "beforeBuildCommand": "pnpm sidecar:build && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Perch",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/perch-sidecar"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "perch"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "perch"
        ]
      }
    }
  }
}
